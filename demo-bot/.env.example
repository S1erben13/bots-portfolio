# Скопируйте в .env:  cp .env.example .env
# .env не коммитится — там будут ваши токены.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Доверенные источники для форм админки за прокси/туннелем, через запятую (https://example.ru)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Логин/пароль администратора демо (создаётся командой seed_demo, если заданы)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin

# --- PostgreSQL ---
POSTGRES_DB=servicebot
POSTGRES_USER=servicebot
POSTGRES_PASSWORD=servicebot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Публичный адрес сайта (куда ведут QR-коды в режиме landing) ---
PUBLIC_BASE_URL=http://localhost:8000
# Куда ведёт QR: landing (страница выбора мессенджера), telegram или max
QR_TARGET=landing

# --- Telegram (получить у @BotFather) ---
# Пусто = Telegram-бот выключен, всё остальное работает.
TELEGRAM_BOT_TOKEN=
# Имя бота без @, нужно для ссылок t.me/<имя>?start=<код>
TELEGRAM_BOT_USERNAME=

# --- MAX (получить на business.max.ru → Чат-боты → Настройки) ---
MAX_BOT_TOKEN=
# Короткое имя бота для ссылок max.ru/<имя>?start=<код>
MAX_BOT_NAME=
MAX_API_URL=https://platform-api2.max.ru
